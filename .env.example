# --- Développement local (copier en .env) ---
SECRET_KEY=dev-only-change-me
DJANGO_SETTINGS_MODULE=config.settings.dev
DATABASE_URL=postgres://sugu:sugu@localhost:5432/sugu

# --- Production (valeurs à renseigner sur le VPS) ---
