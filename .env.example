# --- Développement local (copier en .env) ---
SECRET_KEY=dev-only-change-me
DJANGO_SETTINGS_MODULE=config.settings.dev
DATABASE_URL=postgres://sugu:sugu@localhost:5432/sugu

# --- Production (valeurs à renseigner sur le VPS) ---
# DJANGO_SETTINGS_MODULE=config.settings.prod
# SECRET_KEY=<long aléatoire : python -c "import secrets; print(secrets.token_urlsafe(50))">
# ALLOWED_HOSTS=sugu.ml,www.sugu.ml
# ADMIN_URL=<16 caractères aléatoires au moins, finissant par / : python -c "import secrets; print(secrets.token_urlsafe(16) + '/')">
# Base : « postgres » (superutilisateur, administration seulement) et « sugu » (l'application,
# sans privilège), créés au premier démarrage par docker/postgres/init.
# POSTGRES_PASSWORD=<aléatoire, superutilisateur>
# APP_DB_PASSWORD=<aléatoire, lettres et chiffres>
# DATABASE_URL=postgres://sugu:<APP_DB_PASSWORD>@db:5432/sugu
# Emails par Resend (runbook) : clé API « Sending access » ; l'identifiant est le mot resend.
# EMAIL_URL=smtp+tls://resend:<clé API>@smtp.resend.com:587
# DEFAULT_FROM_EMAIL=Sugu <no-reply@sugu.ml>
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=sugu-prod
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=photos.sugu.ml
# Erreurs vers Sentry (runbook, « Supervision ») : rien n'est envoyé sans DSN.
# SENTRY_DSN=https://<clé>@<org>.ingest.de.sentry.io/<projet>
# Sauvegardes (runbook, « Sauvegardes ») : bucket R2 privé et jeton distincts de ceux des photos.
# BACKUP_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# BACKUP_ACCESS_KEY_ID=
# BACKUP_SECRET_ACCESS_KEY=
# BACKUP_BUCKET=sugu-backups

# --- Connexion avec Google (facultative, ADR 0002, runbook étape 10) ---
# Sans ces deux valeurs, le bouton « Continuer avec Google » n'apparaît pas.
# GOOGLE_CLIENT_ID=<identifiant OAuth « Application Web » de la console Google Cloud>
# GOOGLE_CLIENT_SECRET=
